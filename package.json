{
  "name": "game-deals",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "bun": ">=1.3.0"
  },
  "packageManager": "bun@1.3.13",
  "resolutions": {
    "adm-zip": "^0.6.0",
    "axios": "^1.18.0",
    "brace-expansion": "^5.0.8",
    "esbuild": ">=0.24.3",
    "fast-uri": "^3.1.5",
    "nanoid": "^3.3.16",
    "postcss": "^8.5.23",
    "sharp": "^0.35.0",
    "undici": "^7.29.0"
  },
  "scripts": {
    "dev": "bun --bun next dev",
    "build": "bun --bun next build",
    "start": "bun --bun next start",
    "lint": "bunx biome check .",
    "lint:fix": "bunx biome check --write .",
    "format": "bunx biome format --write .",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate": "bunx drizzle-kit migrate",
    "db:push": "bunx drizzle-kit push",
    "db:studio": "bunx drizzle-kit studio",
    "test": "bun --bun vitest run",
    "test:watch": "bun --bun vitest",
    "test:changed": "bun --bun vitest --changed --reporter=verbose",
    "test:coverage": "bun --bun vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:visual": "playwright test tests/e2e/visual.spec.ts",
    "test:e2e:visual:update": "playwright test tests/e2e/visual.spec.ts --update-snapshots",
    "test:integration": "bun --bun vitest run --config vitest.integration.config.ts",
    "tdd": "bun --bun vitest --changed --reporter=verbose --watch",
    "knip": "bunx knip",
    "audit": "bunx npm audit --audit-level=high",
    "check": "bash scripts/check.sh",
    "fallow": "fallow",
    "sonar:local": "bun run test:coverage && sonar-scanner -Dsonar.projectKey=EmiyaKiritsugu3_game_deals -Dsonar.organization=emiyakiritsugu3 -Dsonar.sources=./src -Dsonar.host.url=https://sonarcloud.io -Dsonar.javascript.lcov.reportPaths=./coverage/lcov.info -Dsonar.exclusions='src/data/collections.ts,src/data/bundles.ts,**/*.test.ts,**/*.test.tsx,**/*.spec.ts,**/node_modules/**,**/.next/**,**/coverage/**,src/app/globals.css'",
    "fallow:audit": "fallow audit",
    "fallow:dead-code": "fallow dead-code",
    "fallow:health": "fallow health",
    "fallow:dupes": "fallow dupes",
    "prepare": "bunx husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@sentry/nextjs": "^10.60.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "@tanstack/react-query": "^5.101.4",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.21.0",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "recharts": "^3.9.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.14"
  },
  "lint-staged": {
    "*.{js,ts,tsx,jsx,mjs,cjs}": [
      "bunx biome check --write"
    ],
    "*.{json,css}": [
      "bunx biome check --write"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-istanbul": "4.1.9",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "fallow": "^2.104.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "knip": "^6.32.1",
    "lint-staged": "^17.3.0",
    "sonarqube-scanner": "^4.4.0",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  }
}
