{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": ["src/app/layout.tsx", "src/app/page.tsx", "src/actions/*.ts"],
  "project": ["src/**/*.{ts,tsx}", "!src/**/*.test.{ts,tsx}"],
  "ignoreDependencies": ["@playwright/test"],
  "ignore": ["test-hl.ts"],
  "ignoreBinaries": [],
  "rules": {
    "exports": "warn",
    "files": "error",
    "dependencies": "warn",
    "devDependencies": "warn",
    "unlisted": "error"
  }
}
