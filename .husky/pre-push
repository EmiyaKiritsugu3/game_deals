#!/usr/bin/env bash
set -euo pipefail

echo "=== Lint + Type Check ==="
bunx biome check .
bunx tsc --noEmit

echo ""
echo "=== Tests + Coverage ==="
bunx vitest run --coverage

echo ""
echo "=== Build ==="
[ ! -f .env.local ] && cp .env.example .env.local
bun --bun next build

echo ""
echo "=== Dead Code ==="
bunx knip --no-exit-code

echo ""
echo "✓ Pre-push gates passed."
