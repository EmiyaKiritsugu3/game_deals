# Supabase Credentials (from Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your-service-role-key

# Database (from Project Settings > Database > Connection string URI)
DATABASE_URL=postgresql://postgres.your-password@aws-1-sa-east-1.pooler.supabase.com:5432/postgres

# Vercel Cron Secret (invent a strong random string)
CRON_SECRET=your-random-cron-secret-here

# Supabase MCP (from Account > Access Tokens)
MCP_SUPABASE_API_KEY=your-supabase-access-token

# Typesense Search
TYPESENSE_ADMIN_KEY=
NEXT_PUBLIC_TYPESENSE_SEARCH_KEY=
NEXT_PUBLIC_TYPESENSE_URL=

# Sentry Error Monitoring (from https://game-deals.sentry.io)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
